# Database and admin panel. Without DATABASE_URL the storefront serves the
# built-in catalogue (src/data/seed-catalog.ts) and the admin panel is off.
DATABASE_URL=postgres://reyso:reyso@localhost:5432/reyso
# Long random string, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=
# Where uploaded images are stored (defaults to ./media).
MEDIA_DIR=

# SMS login codes through Kavenegar (verify/lookup). The template is the
# name of a verification template approved in the Kavenegar panel, with
# %token for the code.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
# Without Kavenegar: 1 = demo mode, nothing is sent and the code is always
# 12345 (never in production). Empty = SMS login is refused.
SMS_DEMO=
# Order updates to the customer by SMS: a second Kavenegar verify template
# with %token (order number) and %token20 (what happened, e.g. "ارسال شد.
# کد رهگیری پست: 123"). Without it nothing is sent; each message is still
# listed on the order's page in the admin panel.
KAVENEGAR_ORDER_TEMPLATE=

# New orders to the shop's Telegram: a bot token from @BotFather and the
# chat id of the person or group to notify. Telegram is filtered on Iranian
# servers; Bale's bot API works the same way: TELEGRAM_API_BASE=https://tapi.bale.ai
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=

# Online payment with Zarinpal. ZARINPAL_SANDBOX=1 uses Zarinpal's test
# gateway (no real money). Without a merchant id: PAYMENT_DEMO=1 shows a
# fake bank page on this site (never in production); empty = orders are
# placed unpaid and payment is arranged with the customer.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=
PAYMENT_DEMO=

# Leave a value empty to keep the demo behaviour for that feature.
NEXT_PUBLIC_SUPPORT_CHAT_URL=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TELEGRAM_USERNAME=
