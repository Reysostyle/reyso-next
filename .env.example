# Database and admin panel. Without DATABASE_URL the storefront serves the
# built-in catalogue (src/data/seed-catalog.ts) and the admin panel is off.
DATABASE_URL=postgres://reyso:reyso@localhost:5432/reyso
# Long random string, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=
# Where uploaded images are stored (defaults to ./media).
MEDIA_DIR=

# Leave a value empty to keep the demo behaviour for that feature.
NEXT_PUBLIC_ORDER_API_URL=
NEXT_PUBLIC_TRACK_LOOKUP_URL=
NEXT_PUBLIC_SEND_OTP_URL=
NEXT_PUBLIC_VERIFY_OTP_URL=
NEXT_PUBLIC_SUPPORT_CHAT_URL=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TELEGRAM_USERNAME=
